{
  "name":
    "local-user-repository",
  "version":
    "0.0.2",
  "description":
    "Local User Repository (lur).",
  "funding": {
    "type":
      "patreon",
    "url":
      "https://patreon.com/tallero"
  },
  "man":
    "./man/tmcsplit.1",
  "files": [
    "AUTHORS.rst",
    "COPYING",
    "README.md",
    "bash",
    "dist",
    "eslint.config.mjs",
    "fs-worker.webpack.config.cjs",
    "serve.json",
    "liblur",
    "liblur.webpack.config.cjs",
    "package.json",
    "webpack.config.cjs"
  ],
  "keywords": [
    "fur",
    "ur",
    "gur",
    "lur",
    "life",
    "themartiancompany",
    "dogeos"
  ],
  "homepage":
    "https://github.com/themartiancompany/lur",
  "bugs": {
    "url":
      "https://github.com/themartiancompany/lur/issues"
  },
  "repository": {
    "type":
      "git",
    "url":
      "git+https://github.com/themartiancompany/lur.git"
  },
  "license":
    "AGPL-3.0-or-later",
  "author": {
    "name":
      "Pellegrino Prevete",
    "email":
      "pellegrinoprevete@gmail.com",
    "url":
      "https://github.com/tallero"
  },
  "devDependencies": {
    "crash-js-webpack":
      "^0.0.79",
    "eslint":
      "^10.9.0",
    "globals":
      "^17.3.0",
    "@eslint/js":
      "^10.0.1",
    "safely-serve":
      "^0.0.22",
    "webpack":
      "^5.109.2",
    "webpack-cli":
      "^7.2.2"
  },
  "dependencies": {
    "libcrash-js":
      "npm:crash-js@^1000000000000013.1000000000000001.1000000000000001"
  },
  "overrides": {
    "lur":
      "./bash/lur"
  },
  "type":
    "module",
  "main":
    "bash/lur",
  "bin":
    { "lur":
        "bash/lur" },
  "scripts": {
    "build-fs-worker":
      "npx webpack --mode 'production' --config 'fs-worker.webpack.config.cjs' --stats-error-details && cp 'fs-worker.js' 'dist/libtmcsplit' && cp 'fs-worker.js' 'dist/tmcsplit'",
    "build-lib":
      "npx webpack --mode 'production' --config 'libtmcsplit.webpack.config.cjs' --stats-error-details && cp 'libtmcsplit.js' 'dist/libtmcsplit'",
    "build-bin":
      "npx webpack --mode 'production' --config 'webpack.config.cjs' --stats-error-details&& cp 'tmcsplit.js' 'dist/tmcsplit'",
    "build":
      "npm run build-fs-worker && npm run build-lib && npm run build-bin",
    "lint":
      "npx eslint .",
    "publish-npm":
      "npm lint && npm run build && npm publish --access public",
    "start":
      "npx safely-serve 'dist/tmcsplit'",
    "test":
      "echo \"Error: no test specified\" && exit 1"
  }
}
